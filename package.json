{
  "name": "omnibuddy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/contracts",
    "packages/ui",
    "packages/desktop",
    "packages/web"
  ],
  "scripts": {
    "build": "bun --workspaces --if-present run build",
    "package:win": "bun --filter @omnibuddy/desktop package:win",
    "package:mac:arm64": "bun --filter @omnibuddy/desktop package:mac:arm64",
    "package:mac:x64": "bun --filter @omnibuddy/desktop package:mac:x64",
    "package:linux": "bun --filter @omnibuddy/desktop package:linux",
    "dev:desktop": "bun --filter @omnibuddy/desktop dev",
    "dev:web": "bun --filter @omnibuddy/web dev",
    "typecheck": "bun --workspaces --if-present run typecheck"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
